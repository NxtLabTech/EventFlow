# Same MongoDB database the Express backend uses (read by `sync_from_mongo`)
MONGODB_URI=mongodb://127.0.0.1:27017/eventflow
# Required when DJANGO_DEBUG is false. Generate a long random string; never commit it.
DJANGO_SECRET_KEY=
# true for local development, false in production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
