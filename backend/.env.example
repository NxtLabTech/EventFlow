# Port the Express API listens on
PORT=5000
# MongoDB connection string (local example; never commit real credentials)
MONGODB_URI=mongodb://127.0.0.1:27017/eventflow
# Allowed frontend origin(s) for CORS, comma separated
CORS_ORIGIN=http://localhost:5173
# development | production
NODE_ENV=development

# Organizer authentication (required for create/update/delete events and listing registrations)
#
# Local demo login (for reviewers / first-time setup):
#   username: organizer
#   password: password
#
# The value below is a bcrypt hash of "password". Change it for any real deployment.
ORGANIZER_USERNAME=organizer
ORGANIZER_PASSWORD_HASH=$2b$10$7S3nVPwmluPGWoHPc.eVgeaqOPla4c0g8pLoOHposs5H6gc.3PFuC
# Secret used to sign JWT access tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
# Optional token lifetime (default 8h). Examples: 1h, 8h, 7d
JWT_EXPIRES_IN=8h
#
# To use a different password, generate a new hash and replace ORGANIZER_PASSWORD_HASH:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
