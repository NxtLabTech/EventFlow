# Port the Express API listens on
PORT=5000
# MongoDB connection string (local example; never commit real credentials)
MONGODB_URI=mongodb://127.0.0.1:27017/eventflow
# Allowed frontend origin(s) for CORS, comma separated
CORS_ORIGIN=http://localhost:5173
# development | production
NODE_ENV=development

# Organizer authentication (required for create/update/delete events and listing registrations)
ORGANIZER_USERNAME=organizer
# bcrypt hash of the organizer password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ORGANIZER_PASSWORD_HASH=
# Secret used to sign JWT access tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
# Optional token lifetime (default 8h). Examples: 1h, 8h, 7d
JWT_EXPIRES_IN=8h
